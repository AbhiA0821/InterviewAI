# Monorepo root .easignore for Expo EAS Build

# Ignore non-mobile components
backend/
frontend/
docs/
docker/
scripts/
.pytest_cache/
*.db
*.sqlite3

# Python environments
.venv/
venv/
env/

# Node & web dependencies/builds
node_modules/
**/node_modules/
.expo/
**/.expo/
.git/
dist/
**/dist/
web-build/

# Mobile build binaries
*.apk
*.aab
*.ipa
*.jks
InterviewAI.apk

# Android build outputs
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/.cxx/
**/android/app/.cxx/

# iOS build outputs
**/ios/Pods/
**/ios/build/
