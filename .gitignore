# -----------------------------------------------------------------------
# InterviewAI - root .gitignore
# -----------------------------------------------------------------------

# --- Environment files ---
.env
.env.local
*.env
!*.env.example

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.db
*.sqlite3
.pytest_cache/
.mypy_cache/

# --- Node / Frontend ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Firebase / Google service accounts ---
firebase-service-account*.json
serviceAccountKey.json

# --- IDE / Editor ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Docker ---
docker/*.env
