# -----------------------------------------------------------------------
# InterviewAI Backend - Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# -----------------------------------------------------------------------

# General
ENVIRONMENT=development
DEBUG=True

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite:///./interviewai.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql://user:password@host:5432/interviewai

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=["http://localhost:5173"]

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON=path/to/firebase-service-account.json

# Gemini / Gemini Live API (Multi-Key Rotation Pool)
# Option 1: Provide a single comma-separated string of 10-12+ keys:
GEMINI_API_KEYS=key_1,key_2,key_3,key_4,key_5,key_6,key_7,key_8,key_9,key_10,key_11,key_12

# Option 2: Or provide numbered keys individually:
# GEMINI_API_KEY_1=AIzaSy...
# GEMINI_API_KEY_2=AIzaSy...
# ...
# GEMINI_API_KEY_12=AIzaSy...

# Option 3: Standard single key for backwards compatibility:
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Simli (future real-time AI avatar integration)
SIMLI_API_KEY=your-simli-api-key

# Security
SECRET_KEY=change-me-in-production
