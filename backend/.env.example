# -----------------------------------------------------------------------
# InterviewAI Backend - Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# -----------------------------------------------------------------------

# General
ENVIRONMENT=development
DEBUG=True

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite:///./interviewai.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql://user:password@host:5432/interviewai

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=["http://localhost:5173"]

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON=path/to/firebase-service-account.json

# Gemini / Gemini Live API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Simli (future real-time AI avatar integration)
SIMLI_API_KEY=your-simli-api-key

# Security
SECRET_KEY=change-me-in-production
