# -----------------------------------------------------------------------
# InterviewAI Frontend - Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# Vite only exposes variables prefixed with VITE_ to client-side code.
# -----------------------------------------------------------------------

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Firebase Web SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Simli (future real-time AI avatar integration)
VITE_SIMLI_API_KEY=
