{
  "expo": {
    "name": "InterviewAI",
    "slug": "interviewai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interviewai.app"
    },
    "android": {
      "package": "com.interviewai.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "InterviewAI needs access to your microphone for live voice AI interviews."
        }
      ]
    ]
  }
}
